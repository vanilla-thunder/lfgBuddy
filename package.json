{
  "name": "lfg-buddy",
  "version": "0.1.0",
  "description": "In-game overlay with cross-machine sync for LFG coordination",
  "main": "main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "electron . --dev",
    "prod": "electron . --prod",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "sigstore": "5.0.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.vanilla-thunder.lfgbuddy",
    "productName": "LFG Buddy",
    "artifactName": "LFG-Buddy-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "client/**",
      "shared/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "LFG Buddy",
        "schemes": [
          "lfgbuddy"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vanilla-thunder",
        "repo": "lfgBuddy",
        "publisherName": [
          "sigstore"
        ]
      }
    ]
  }
}
